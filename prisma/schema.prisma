generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String         @id @default(cuid())
  name        String
  phone       String         @unique
  password    String
  avatarUrl   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  memberships SamityMember[]
  payments    Payment[]
}

model Samity {
  id                 String         @id @default(cuid())
  name               String
  description        String?
  fixedDepositAmount Float          @default(5000)
  currentMonthIndex  Int            @default(0)
  monthsList         String         @default("[\"October 2026\",\"November 2026\",\"December 2026\",\"January 2027\",\"February 2027\",\"March 2027\"]")
  bKashNumber        String?        @default("01700-998877")
  nagadNumber        String?        @default("01800-112233")
  bankDetails        String?        @default("City Bank, A/C: 1502-8899-001, Branch: Gulshan")
  cashInstructions   String?        @default("Handover cash directly to Samity Admin")
  creatorId          String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  members            SamityMember[]
  payments           Payment[]
  winners            Winner[]
}

model SamityMember {
  id                   String    @id @default(cuid())
  samityId             String
  userId               String
  role                 String    @default("MEMBER") // "ADMIN" or "MEMBER"
  hasWonInCurrentCycle Boolean   @default(false)
  wonMonth             String?
  wonAmount            Float?
  joinedAt             DateTime  @default(now())
  samity               Samity    @relation(fields: [samityId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments             Payment[]
  winners              Winner[]

  @@unique([samityId, userId])
}

model Payment {
  id          String       @id @default(cuid())
  samityId    String
  memberId    String
  userId      String
  month       String
  amount      Float
  method      String // "bKash" | "Nagad" | "Bank Transfer" | "Cash on Hand"
  trxId       String
  screenshot  String
  status      String       @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())
  samity      Samity       @relation(fields: [samityId], references: [id], onDelete: Cascade)
  member      SamityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Winner {
  id       String       @id @default(cuid())
  samityId String
  memberId String
  month    String
  amount   Float
  wonAt    DateTime     @default(now())
  samity   Samity       @relation(fields: [samityId], references: [id], onDelete: Cascade)
  member   SamityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}
